{
  "name": "vue-responsiveness",
  "private": false,
  "files": [
    "dist",
    "lib",
    "docs"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/vue-responsiveness.umd.cjs",
  "module": "./dist/vue-responsiveness.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-responsiveness.js",
      "require": "./dist/vue-responsiveness.umd.cjs"
    }
  },
  "keywords": [
    "vue",
    "vue3",
    "vue responsiveness plugin",
    "vue plugin",
    "responsiveness",
    "responsive design",
    "responsiveness breakpoints",
    "responsiveness interval",
    "breakpoints",
    "custom breakpoints",
    "matchmedia",
    "window matchmedia",
    "match media",
    "media query",
    "media queries",
    "@media",
    "css",
    "bootstrap",
    "bulma",
    "chakra",
    "foundation",
    "ionic",
    "material design",
    "materialize",
    "material ui",
    "quasar",
    "semantic ui",
    "Skeleton",
    "vuetify",
    "tailwind",
    "tailwindcss",
    "windi",
    "windicss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemonk-digital/vue-responsiveness.git"
  },
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "vue-tsc --build",
    "verify": "pnpm lint && pnpm build && pnpm check:package && pnpm coverage",
    "check:package": "tsc -p test/consumer/tsconfig.json && tsc -p test/consumer/tsconfig.bundler.json && node scripts/check-package.mjs",
    "prepack": "npm run build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx,js,jsx,cjs,mjs",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.2",
    "vite": "^8.3.3",
    "vitest": "^4.1.12",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "prettier": {
    "trailingComma": "none",
    "semi": false,
    "singleQuote": true
  },
